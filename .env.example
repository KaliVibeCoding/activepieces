## It's advisable to consult the documentation and use KVC tools/deploy.sh to generate the passwords, keys, instead of manually filling them.

KVC_ENGINE_EXECUTABLE_PATH=dist/packages/kvc-engine/main.js # KVC: Path updated

## Random Long Password (Optional for community edition)
KVC_API_KEY=

## 256 bit encryption key, 32 hex character
KVC_ENCRYPTION_KEY= # KVC: Add _KVC suffix if needed for uniqueness: PLEASE_CHANGE_TO_32_CHAR_RANDOM_STRING_AND_KEEP_IT_SECRETLY_KVC

## JWT Secret
KVC_JWT_SECRET= # KVC: Add _KVC suffix if needed for uniqueness: PLEASE_CHANGE_TO_BE_A_REAL_SECRET_AND_KEEP_IT_SECRETLY_KVC

KVC_ENVIRONMENT=prod
KVC_FRONTEND_URL=http://localhost:8080
KVC_WEBHOOK_TIMEOUT_SECONDS=30
KVC_TRIGGER_DEFAULT_POLL_INTERVAL=5 # KVC: Consider KVC_SEQUENCE_DEFAULT_POLL_INTERVAL
KVC_POSTGRES_DATABASE=kalivibecoding # KVC: Database name changed
KVC_POSTGRES_HOST=kvc-postgres # KVC: Hostname for docker compose
KVC_POSTGRES_PORT=5432
KVC_POSTGRES_USERNAME=kvcuser # KVC: Default user changed
KVC_POSTGRES_PASSWORD=kvcpassword # KVC: Default password changed (ensure this is a placeholder, not a real password)
KVC_EXECUTION_MODE=UNSANDBOXED # KVC: Or SANDBOXED based on KVC preference
KVC_REDIS_HOST=kvc-redis # KVC: Hostname for docker compose
KVC_REDIS_PORT=6379
KVC_FLOW_TIMEOUT_SECONDS=600 # KVC: Consider KVC_SEQUENCE_TIMEOUT_SECONDS
KVC_TELEMETRY_ENABLED=true
KVC_TEMPLATES_SOURCE_URL="https://cloud.kalivibecoding.com/api/v1/blueprint-templates" # KVC: URL and resource name changed

# KVC: Additional variables from previous longer .env.example that might be relevant
KVC_API_URL=http://localhost:3000 # Or match KVC_FRONTEND_URL if API is through same port
KVC_REDIS_USER=
KVC_REDIS_PASSWORD=
KVC_REDIS_USE_SSL=false
KVC_SANDBOX_RUN_TIME_SECONDS=180
KVC_SIGN_UP_ENABLED=true
KVC_FLOW_WORKER_CONCURRENCY=10 # KVC: Consider KVC_SEQUENCE_WORKER_CONCURRENCY
KVC_WEBHOOK_URL=http://localhost:3000/ # Or match KVC_API_URL
KVC_STORE_PATH=./kvc-blueprint-vault # KVC: Changed path name
KVC_PIECES_SOURCE=FILE # KVC: Consider KVC_CONNECTORS_SOURCE
KVC_LOG_LEVEL=INFO
KVC_LOG_FORMAT=JSON
KVC_JWT_ISSUER=kalivibecoding
KVC_JWT_AUDIENCE=kalivibecoding
KVC_NODE_EXECUTABLE_PATH=
KVC_FRONTEND_URL_IS_PUBLIC=false
KVC_SENTRY_DSN=
KVC_OPENAI_API_KEY=
KVC_SCHEDULE_CRON_EXPRESSION="* * * * *"
KVC_PIECES_SOURCE_URL_PREFIX= # KVC: Consider KVC_CONNECTORS_SOURCE_URL_PREFIX
KVC_PIECES_SOURCE_BRANCH_OR_TAG=main
KVC_PIECES_SOURCE_PATH_PREFIX=dist/packages/kvc-connectors/community/ # KVC: Path updated
KVC_PIECES_CUSTOM_PATH_PREFIX=dist/packages/kvc-connectors/custom/ # KVC: Path updated
KVC_PIECES_SYNC_MODE=OFFICIAL_AND_CUSTOM # KVC: Consider KVC_CONNECTORS_SYNC_MODE
KVC_PIECES_CLOUD_AUTH_ENABLED=false # KVC: Consider KVC_CONNECTORS_CLOUD_AUTH_ENABLED
KVC_DEFAULT_LOCALE=en
KVC_QUEUE_MODE=MEMORY
KVC_QUEUE_RESULTS_RETENTION_SECONDS=86400
KVC_WORKERS_PER_CPU=1
KVC_ENABLE_DB_HEALTH_CHECK=true
KVC_ENABLE_REDIS_HEALTH_CHECK=true
KVC_COOKIE_OPTIONS_PATH=/
KVC_COOKIE_OPTIONS_MAX_AGE=31536000
KVC_COOKIE_OPTIONS_HTTP_ONLY=true
KVC_COOKIE_OPTIONS_SECURE=true
KVC_COOKIE_OPTIONS_SAME_SITE=lax
KVC_COOKIE_OPTIONS_DOMAIN=
KVC_COOKIE_OPTIONS_SIGNED=true
